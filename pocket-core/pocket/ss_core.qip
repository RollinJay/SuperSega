# Super Sega core sources (machine + Pocket platform layer)
# SYNTHESIS leaves out the simulation-only blocks (`ifndef SYNTHESIS), as Yosys does
set_global_assignment -name VERILOG_MACRO "SYNTHESIS=1"
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) "core_top.v"]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) "core_bridge_cmd.v"]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) "ss_pocket.v"]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) "ss_pll.v"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "third_party/agg23/data_loader.sv"]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) "ss_save_unload.v"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "third_party/agg23/sound_i2s.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "third_party/agg23/sync_fifo.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "third_party/agg23/psram.sv"]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) "rtl/ss_top.v"]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) "rtl/ss_z80.v"]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) "rtl/ss_mem.v"]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) "rtl/ss_io.v"]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) "rtl/ss_vdp.v"]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) "rtl/ss_psg.v"]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) "rtl/ss_dpram.v"]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) "rtl/third_party/tv80/tv80_core.v"]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) "rtl/third_party/tv80/tv80_alu.v"]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) "rtl/third_party/tv80/tv80_mcode.v"]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) "rtl/third_party/tv80/tv80_reg.v"]
set_global_assignment -name SEARCH_PATH [file join $::quartus(qip_path) "rtl/third_party/tv80"]
set_global_assignment -name SDC_FILE [file join $::quartus(qip_path) "core_constraints.sdc"]
